# Copy this file to .env in the same folder and fill in real values.
# .env is already covered by the repo's root .gitignore (**/.env) — never commit it.

NODE_ENV=development

# --- Shared JWT config (Phase 1 simplification: one shared secret across
# Gateway + Auth Service so the Gateway can verify tokens locally, without
# a network round-trip to Auth Service on every request) ---
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- CORS ---
# The frontend origin allowed to call the gateway. Update for prod
# (e.g. https://your-vercel-app.vercel.app) once the frontend talks to this stack.
CORS_ORIGIN=http://localhost:5173

# --- Google OAuth ---
# Get this from: Google Cloud Console -> APIs & Services -> Credentials
# -> Create Credentials -> OAuth client ID -> Application type: Web application.
# Authorized JavaScript origins should include http://localhost:5173 (dev)
# and your real frontend URL (prod). No client secret is needed here since
# the Auth Service only verifies ID tokens (google-auth-library), it doesn't
# perform a server-side code exchange in this phase.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated list of Google account emails that are always granted the
# "admin" role on login (checked on every login, so it self-heals). This is
# how the hidden manager-access entry point (double-click the homepage hero
# chef image) works for a demo deployment without a self-serve staff signup.
ADMIN_EMAILS=gpraneeth555@gmail.com,hrudhayr6885@gmail.com

# --- Mongo (single container, one logical database per service) ---
MONGO_URI=mongodb://mongo:27017
AUTH_DB_NAME=auth_db
RESERVATION_DB_NAME=reservation_db
ORDER_DB_NAME=order_db
PAYMENT_DB_NAME=payment_db
NOTIFICATION_DB_NAME=notification_db

# --- Redis (Gateway rate limiting) ---
REDIS_URL=redis://redis:6379

# --- RabbitMQ (stood up now, unused until the Payment/Order services in Phase 4) ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# --- Gateway ---
GATEWAY_PORT=8080
AUTH_SERVICE_URL=http://auth-service:4001
RESERVATION_SERVICE_URL=http://reservation-service:4002
ORDER_SERVICE_URL=http://order-service:4003
PAYMENT_SERVICE_URL=http://payment-service:4004
NOTIFICATION_SERVICE_URL=http://notification-service:4005

# --- Auth Service ---
AUTH_SERVICE_PORT=4001

# --- Reservation Service ---
RESERVATION_SERVICE_PORT=4002

# --- Order Service ---
ORDER_SERVICE_PORT=4003

# --- Payment Service ---
PAYMENT_SERVICE_PORT=4004
# Stripe test-mode secret key: dashboard.stripe.com -> Developers -> API keys
# (use the "Secret key" under Test mode, starts with sk_test_)
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_secret_key
# For local testing without live Stripe webhook delivery, any random string
# works here as long as it matches whatever signs your test webhook calls.
# For real Stripe CLI forwarding (`stripe listen --forward-to ...`), use the
# whsec_ value the CLI prints.
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret

# --- Notification Service ---
NOTIFICATION_SERVICE_PORT=4005
# Optional: a real SMTP provider. If left unset, the service auto-provisions
# a free Ethereal test inbox on startup (no signup needed) and logs a
# preview URL for every email it "sends" -- fine for local dev/demo.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
